# AI プロバイダー設定
# "claude" に設定すると Anthropic Claude API を使用します
# 未設定またはその他の値はダミーAIにフォールバックします
AI_PROVIDER=

# Anthropic API キー（AI_PROVIDER=claude の場合に必要）
ANTHROPIC_API_KEY=

# Supabase 設定
# Supabase プロジェクトの Settings > API から取得してください
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# アプリの公開URL（OAuth リダイレクト先の管理用）
# 本番環境では実際のドメインを設定し、Supabase の Redirect URLs 許可リストにも追加すること
NEXT_PUBLIC_APP_URL=http://localhost:3000
