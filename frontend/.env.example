# AI プロバイダー設定
# "claude" に設定すると Anthropic Claude API を使用します
# 未設定またはその他の値はダミーAIにフォールバックします
AI_PROVIDER=

# Anthropic API キー（AI_PROVIDER=claude の場合に必要）
ANTHROPIC_API_KEY=

# Supabase 設定
# Supabase プロジェクトの Settings > API から取得してください
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google OAuth                                                                                      
GOOGLE_CLIENT_ID=クライアントID                                                                     
GOOGLE_CLIENT_SECRET=クライアントシークレット

# NextAuth（openssl rand -base64 32 で生成したランダム文字列）                                      
NEXTAUTH_SECRET=ランダム文字列
NEXTAUTH_URL=http://localhost:3000       