# ============================================================     
# Relief フロントエンド 環境変数テンプレート                       
# このファイルをコピーして .env.local を作成してください           
# ============================================================     

# ---- アプリ環境 ----                                             
# local | staging | production
APP_ENV=local

# ---- NextAuth ----
# NEXTAUTH_SECRET: openssl rand -base64 32 で生成してください
NEXTAUTH_SECRET=
# NEXTAUTH_URL: ローカルは http://localhost:3000、本番は Vercel のURL                                                                
NEXTAUTH_URL=http://localhost:3000

# ---- Google OAuth ----                                           
# Google Cloud Console > 認証情報 > OAuth 2.0 クライアント IDから取得リダイレクト URI に以下を追加すること:
#   http://localhost:3000/api/auth/callback/google（ローカル）
#   https://<your-domain>/api/auth/callback/google（本番）         
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ---- Supabase ----
# Project Settings > API から取得
# NEXT_PUBLIC_SUPABASE_URL: クライアント・サーバー両方から参照
NEXT_PUBLIC_SUPABASE_URL=                                          
# SUPABASE_SERVICE_ROLE_KEY: サーバー側（API Route）専用。クライアントに露出しないこと                          
SUPABASE_SERVICE_ROLE_KEY=