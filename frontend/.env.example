# =====================================================================
# 実行環境の設定
# =====================================================================
# APP_ENV で CSP・HSTS・Service Worker の動作を切り替える
#   local      : ローカル開発（unsafe-eval 許可、HSTS 無効、Service Worker 無効）
#   staging    : Vercel 上での動作確認（本番同等の設定で確認したい場合）
#   production : 本番（デフォルト。未設定時もこの動作になる）
APP_ENV=local

# =====================================================================
# Supabase 設定
# =====================================================================
# Supabase プロジェクトの Settings > API から取得してください
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# アプリの公開URL（OAuth リダイレクト先の管理用）
# ローカル  : http://localhost:3000
# staging  : https://relief-xxx.vercel.app （Vercel の自動発行 URL）
# production: https://your-domain.com
# Supabase の Authentication > Redirect URLs にも同じ URL を追加すること
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =====================================================================
# AI プロバイダー設定（有料機能。現時点では未実装）
# =====================================================================
# "claude" に設定すると Anthropic Claude API を使用します
# 未設定またはその他の値はダミー AI にフォールバックします
AI_PROVIDER=

# Anthropic API キー（AI_PROVIDER=claude の場合に必要）
ANTHROPIC_API_KEY=
